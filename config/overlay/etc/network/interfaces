# loopback interface
auto lo
iface lo inet loopback

# ethernet interface --- DHCP. The bench DHCP server hands out the
# reserved bench IPs (172.25.0.115/140) keyed by MAC, so SSH to
# either ssh.custom or ssh.target reaches whichever board is
# currently powered on. The custom S40network falls back to
# /sbin/ifup -a when iface_method != static, which runs udhcpc.
auto eth0
iface eth0 inet dhcp
