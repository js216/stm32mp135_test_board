# Copyright (c) 2026 Jakob Kastelic

# loopback interface
auto lo
iface lo inet loopback

# ethernet interface (static; same image flashed to both boards, both
# bench IPs configured so SSH to either ssh.custom or ssh.target reaches
# whichever board is currently powered on)
auto eth0
iface eth0 inet static
    address 172.25.0.140
    netmask 255.255.255.0
    post-up ip addr add 172.25.0.115/24 dev eth0
