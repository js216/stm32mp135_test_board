#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Jakob Kastelic
#
# Start the network....
#

# Debian ifupdown needs the /run/network lock directory
mkdir -p /run/network

IFUP_TIMEOUT_S="${IFUP_TIMEOUT_S:-60}"
IFACES_FILE=/etc/network/interfaces

iface_field()
{
	awk -v iface="$1" -v key="$2" '
		$1 == "iface" && $2 == iface && $3 == "inet" {
			in_iface = 1
			next
		}
		$1 == "iface" {
			in_iface = 0
		}
		in_iface && $1 == key {
			print $2
			exit
		}
	' "$IFACES_FILE"
}

iface_method()
{
	awk -v iface="$1" '
		$1 == "iface" && $2 == iface && $3 == "inet" {
			print $4
			exit
		}
	' "$IFACES_FILE"
}

prefix_from_netmask()
{
	case "$1" in
		255.255.255.255) echo 32 ;;
		255.255.255.254) echo 31 ;;
		255.255.255.252) echo 30 ;;
		255.255.255.248) echo 29 ;;
		255.255.255.240) echo 28 ;;
		255.255.255.224) echo 27 ;;
		255.255.255.192) echo 26 ;;
		255.255.255.128) echo 25 ;;
		255.255.255.0) echo 24 ;;
		255.255.254.0) echo 23 ;;
		255.255.252.0) echo 22 ;;
		255.255.248.0) echo 21 ;;
		255.255.240.0) echo 20 ;;
		255.255.224.0) echo 19 ;;
		255.255.192.0) echo 18 ;;
		255.255.128.0) echo 17 ;;
		255.255.0.0) echo 16 ;;
		*) return 1 ;;
	esac
}

wait_for_iface()
{
	iface="$1"
	deadline="$(($(date +%s) + IFUP_TIMEOUT_S))"

	while [ ! -e "/sys/class/net/$iface" ]; do
		if [ "$(date +%s)" -ge "$deadline" ]; then
			return 1
		fi
		sleep 1
	done
}

start_static_iface()
{
	iface="$1"
	address="$(iface_field "$iface" address)"
	netmask="$(iface_field "$iface" netmask)"
	prefix="$(prefix_from_netmask "$netmask")"

	[ -n "$address" ] && [ -n "$prefix" ] || return 1

	wait_for_iface "$iface" || return 1
	ip link set lo up 2>/dev/null || true
	killall udhcpc 2>/dev/null || true
	ip addr flush dev "$iface" 2>/dev/null || true
	ip link set "$iface" up || return 1
	ip addr add "$address/$prefix" dev "$iface" || return 1
}

start_network()
{
	if [ "$(iface_method eth0)" = "static" ]; then
		start_static_iface eth0
		return $?
	fi

	# Run ifup fully detached so DHCP (udhcpc) cannot block boot.
	# The bench tests do not require networking to be up before the
	# login prompt, and the slow synchronous wait here was pushing
	# `buildroot login:` past the mission's blind-delay window after
	# `jump\r`. Output is redirected to /var/log so a curious operator
	# can still inspect ifup's progress post-boot.
	mkdir -p /var/log
	(/sbin/ifup -a >/var/log/ifup.log 2>&1) &
	return 0
}

case "$1" in
  start)
	printf "Starting network: "
	start_network
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  stop)
	printf "Stopping network: "
	/sbin/ifdown -a
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
