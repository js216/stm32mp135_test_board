# Start the network....
#

# Debian ifupdown needs the /run/network lock directory
mkdir -p /run/network

IFUP_TIMEOUT_S="${IFUP_TIMEOUT_S:-60}"

start_network()
{
	/sbin/ifup -a &
	pid="$!"
	deadline="$(($(date +%s) + IFUP_TIMEOUT_S))"

	while kill -0 "$pid" 2>/dev/null; do
		if [ "$(date +%s)" -ge "$deadline" ]; then
			printf "timeout waiting for ifup "
			kill "$pid" 2>/dev/null
			wait "$pid" 2>/dev/null
			return 1
		fi
		sleep 1
	done

	wait "$pid"
}

case "$1" in
  start)
	printf "Starting network: "
	start_network
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  stop)
	printf "Stopping network: "
	/sbin/ifdown -a
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
