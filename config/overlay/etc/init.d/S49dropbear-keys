#!/bin/sh
# SPDX-License-Identifier: MIT
# S49dropbear-keys --- install deterministic test SSH keys
# Copyright (c) 2026 Jakob Kastelic

set -eu

HOST_KEY_SRC=/etc/dropbear/dropbear_ed25519_host_key.bin
HOST_KEY_DST=/etc/dropbear/dropbear_ed25519_host_key
AUTH_KEYS_SRC=/etc/dropbear/authorized_keys.root.txt
AUTH_KEYS_DIR=/root/.ssh
AUTH_KEYS_DST=${AUTH_KEYS_DIR}/authorized_keys

mount_root_rw_if_possible() {
    root_dev="$(awk '$2 == "/" { print $1; exit }' /proc/mounts)"
    if [ -n "$root_dev" ]; then
        mount -o remount,rw "$root_dev" / 2>/dev/null && return 0
    fi
    mount -o remount,rw / 2>/dev/null || true
}

install_file_if_possible() {
    src=$1
    dst=$2
    mode=$3

    if [ ! -f "$src" ]; then
        return 0
    fi

    chmod "$mode" "$src" || true

    if [ -f "$dst" ] && cmp -s "$src" "$dst"; then
        chmod "$mode" "$dst" || true
        return 0
    fi

    if cp "$src" "$dst"; then
        chmod "$mode" "$dst" || true
    else
        echo "warning: could not install $dst; keeping image copy"
    fi
}

case "$1" in
    start)
        mount_root_rw_if_possible
        install_file_if_possible "$HOST_KEY_SRC" "$HOST_KEY_DST" 600
        if [ ! -d "$AUTH_KEYS_DIR" ]; then
            mkdir -p "$AUTH_KEYS_DIR" || true
        fi
        chmod 700 "$AUTH_KEYS_DIR" 2>/dev/null || true
        install_file_if_possible "$AUTH_KEYS_SRC" "$AUTH_KEYS_DST" 600
        ;;
esac
