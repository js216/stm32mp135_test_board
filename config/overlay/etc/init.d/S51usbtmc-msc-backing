#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Jakob Kastelic
# Create the deterministic USBTMC MSC backing file.

BACKING_DIR=/var/lib/usbtmc
BACKING_FILE=$BACKING_DIR/msc-backing.bin
MARKER='USBTMC EVB MSC BACKING'
MARKER_LEN=23
BACKING_LEN=4096
root_was_ro=0

fail()
{
    if [ "$root_was_ro" -eq 1 ]; then
        mount -o remount,ro /
    fi
    exit 1
}

case "$1" in
    start)
        if grep -qs '^[^ ]* / [^ ]* ro[, ]' /proc/mounts; then
            mount -o remount,rw / || fail
            root_was_ro=1
        fi
        mkdir -p "$BACKING_DIR" || fail
        {
            printf '%s\n' "$MARKER" &&
            dd if=/dev/zero bs=$((BACKING_LEN - MARKER_LEN)) count=1 2>/dev/null
        } > "$BACKING_FILE" || fail
        chmod 0644 "$BACKING_FILE" || fail
        sync
        if [ "$root_was_ro" -eq 1 ]; then
            mount -o remount,ro / || fail
        fi
        ;;
esac

exit 0
