				#size-cells = <0>;
				compatible = "st,stm32-timers";
				reg = <0x4c009000 0x400>;
				interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>;
				interrupt-names = "global";
				clocks = <&rcc TIM14_K>;
				clock-names = "int";
				access-controllers = <&etzpc STM32MP1_ETZPC_TIM14_ID>;
				status = "disabled";

				pwm {
