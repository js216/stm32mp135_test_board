				interrupts = <GIC_SPI 86 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&rcc SPI5_K>;
				resets = <&rcc SPI5_R>;
				#address-cells = <1>;
				#size-cells = <0>;
				dmas = <&dmamux1 85 0x400 0x01>,
				       <&dmamux1 86 0x400 0x01>;
				dma-names = "rx", "tx";
				access-controllers = <&etzpc STM32MP1_ETZPC_SPI5_ID>;
