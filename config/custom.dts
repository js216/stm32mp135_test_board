				compatible = "st,stm32h7-spi";
				reg = <0x4c002000 0x400>;
				interrupts = <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&rcc SPI4_K>;
				resets = <&rcc SPI4_R>;
				#address-cells = <1>;
				#size-cells = <0>;
				dmas = <&dmamux1 83 0x400 0x01>,
