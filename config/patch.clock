diff --git a/drivers/clk/stm32/clk-stm32-core.c b/drivers/clk/stm32/clk-stm32-core.c
index 4d3c2d2f40c7..c9eca80b7eda 100644
--- a/drivers/clk/stm32/clk-stm32-core.c
+++ b/drivers/clk/stm32/clk-stm32-core.c
@@ -22,6 +22,9 @@ static DEFINE_SPINLOCK(rlock);
 static void stm32_clk_summary_debugfs_create(struct device *dev,
 					     const struct stm32_rcc_match_data *data);
 
+#define stm32_rcc_reset_init(dev, match, base) \
+	stm32_rcc_reset_init(dev, ((const struct stm32_rcc_match_data *)(match)->data)->reset_data, base)
+
 static int stm32_rcc_clock_init(struct device *dev,
 				const struct of_device_id *match,
 				void __iomem *base)
@@ -82,7 +85,6 @@ static int stm32_rcc_clock_init(struct device *dev,
 int stm32_rcc_init(struct device *dev, const struct of_device_id *match_data,
 		   void __iomem *base)
 {
-	const struct stm32_rcc_match_data *rcc_match_data;
 	const struct of_device_id *match;
 	int err;
 
@@ -92,10 +94,8 @@ int stm32_rcc_init(struct device *dev, const struct of_device_id *match_data,
 		return -ENODEV;
 	}
 
-	rcc_match_data = match->data;
-
 	/* RCC Reset Configuration */
-	err = stm32_rcc_reset_init(dev, rcc_match_data->reset_data, base);
+	err = stm32_rcc_reset_init(dev, match, base);
 	if (err) {
 		pr_err("stm32 reset failed to initialize\n");
 		return err;
