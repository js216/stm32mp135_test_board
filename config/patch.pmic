diff --git a/drivers/mfd/stpmic1.c b/drivers/mfd/stpmic1.c
index eeb761134297..ae2ff34be7e0 100644
--- a/drivers/mfd/stpmic1.c
+++ b/drivers/mfd/stpmic1.c
@@ -149,8 +149,7 @@ static int stpmic1_probe(struct i2c_client *i2c)
 
 	ddata->irq = of_irq_get(np, STPMIC1_MAIN_IRQ);
 	if (ddata->irq < 0) {
-		dev_err(dev, "Failed to get main IRQ: %d\n", ddata->irq);
-		return ddata->irq;
+		dev_warn(dev, "No main IRQ configured: %d\n", ddata->irq);
 	}
 
 	ret = regmap_read(ddata->regmap, VERSION_SR, &reg);
@@ -161,13 +160,15 @@ static int stpmic1_probe(struct i2c_client *i2c)
 	dev_info(dev, "PMIC Chip Version: 0x%x\n", reg);
 
 	/* Initialize PMIC IRQ Chip & associated IRQ domains */
-	ret = devm_regmap_add_irq_chip(dev, ddata->regmap, ddata->irq,
-				       IRQF_ONESHOT | IRQF_SHARED,
-				       0, &stpmic1_regmap_irq_chip,
-				       &ddata->irq_data);
-	if (ret) {
-		dev_err(dev, "IRQ Chip registration failed: %d\n", ret);
-		return ret;
+	if (ddata->irq > 0) {
+		ret = devm_regmap_add_irq_chip(dev, ddata->regmap, ddata->irq,
+					       IRQF_ONESHOT | IRQF_SHARED,
+					       0, &stpmic1_regmap_irq_chip,
+					       &ddata->irq_data);
+		if (ret) {
+			dev_err(dev, "IRQ Chip registration failed: %d\n", ret);
+			return ret;
+		}
 	}
 
 	ret = devm_register_sys_off_handler(ddata->dev,
diff --git a/drivers/regulator/stpmic1_regulator.c b/drivers/regulator/stpmic1_regulator.c
index 93aede02cc26..3ec99f1e069c 100644
--- a/drivers/regulator/stpmic1_regulator.c
+++ b/drivers/regulator/stpmic1_regulator.c
@@ -360,7 +360,7 @@ static const struct regulator_ops stpmic1_switch_regul_ops = {
 	.type = REGULATOR_VOLTAGE, \
 	.owner = THIS_MODULE, \
 	.min_uV = 0, \
-	.fixed_uV = 5000000, \
+	.fixed_uV = 3300000, \
 	.enable_reg = BST_SW_CR, \
 	.enable_mask = SWIN_SWOUT_ENABLED, \
 	.enable_val = SWIN_SWOUT_ENABLED, \
