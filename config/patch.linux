+static int stm32mp1_restart(struct sys_off_data *data)
+{
+	void __iomem *rcc_base = data->cb_data;
+
+	pr_info("System reset requested...\n");
+	dsb(sy);
+	writel(RCC_MP_GRSTCSETR_MPSYSRST, rcc_base + RCC_MP_GRSTCSETR);
+
+	while (1)
+		wfe();
+
+	return NOTIFY_DONE;
+}
+
+static int stm32mp1_poweroff(struct sys_off_data *data)
+{
+	pr_emerg("Powerdown not yet implemented ...!\n");
+
+	return NOTIFY_DONE;
+}
+
 static int stm32mp1_rcc_clocks_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	void __iomem *base;
+	int ret;
 
 	base = devm_platform_ioremap_resource(pdev, 0);
 	if (WARN_ON(IS_ERR(base)))
 		return PTR_ERR(base);
 
-	return stm32_rcc_init(dev, stm32mp13_match_data, base);
+	ret = stm32_rcc_init(dev, stm32mp13_match_data, base);
+	if (ret)
+		return ret;
+
+	devm_register_sys_off_handler(dev, SYS_OFF_MODE_RESTART,
+				      SYS_OFF_PRIO_HIGH, stm32mp1_restart, base);
+	devm_register_sys_off_handler(dev, SYS_OFF_MODE_POWER_OFF,
+				      SYS_OFF_PRIO_HIGH, stm32mp1_poweroff, NULL);
+
+	return 0;
 }
 
 static struct platform_driver stm32mp13_rcc_clocks_driver = {
