			)
			(justify left)
		)
		(uuid "a6493505-5969-4a5e-b604-4bd491922795")
	)
	(text "10K ALLOWS USING\nADJUSTABLE VERSION\nOF POWER SWITCH"
		(exclude_from_sim no)
		(at 61.976 114.3 0)
		(effects
