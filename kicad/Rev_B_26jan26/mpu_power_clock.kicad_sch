	)
	(text "VDD3V3_USBHS MUST BE OFF IF VDDA1V8_REG IS OFF\n(MANDATORY MPU REQUIREMENT). NCP380 SWITCHES ON\nIF PIN 4 IS ABOVE 1.2V. (10K DISCHARGES 1U)"
